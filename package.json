{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "lint": "npm run lint:source && npm run lint:components",
        "lint:source": "npm exec --yes --package=oxlint@1.95.0 -- oxlint --react-plugin --deny-warnings resources scripts tests public/portal-worker.js public/scorm-bridge.js vite.config.js playwright*.config.ts",
        "lint:components": "node scripts/qualification/check-component-layout.mjs",
        "typecheck": "tsc --noEmit",
        "test:structure": "node --test tests/frontend/structure.test.mjs",
        "test:frontend": "node --test tests/frontend/*.test.mjs",
        "dev": "vite",
        "test:e2e": "npm run build && playwright test && playwright test --config=playwright.academic-core.config.ts && playwright test --config=playwright.placements.config.ts"
    },
    "devDependencies": {
        "@playwright/test": "1.62.1",
        "@tailwindcss/vite": "^4.0.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "shadcn": "4.23.1",
        "tailwindcss": "^4.0.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "^7.0.2",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@inertiajs/react": "^3.11.0",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.5.2",
        "lucide-react": "^1.80.0",
        "radix-ui": "^1.8.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    }
}
