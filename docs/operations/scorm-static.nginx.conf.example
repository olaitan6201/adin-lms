# Inside a dedicated static-only server. Replace LMS_ORIGIN with the exact HTTPS
# LMS origin (no trailing slash). Set root to a copy of resources/scorm-static.
# No shared upstreams, other locations, cookies, SSO or dynamic handlers.
if ($http_cookie != "") { return 403; }
if ($http_authorization != "") { return 403; }
add_header Content-Security-Policy "default-src 'none'; script-src 'self'; frame-src 'self'; frame-ancestors 'self' LMS_ORIGIN; base-uri 'none'; form-action 'none'; object-src 'none'" always;
add_header Referrer-Policy "no-referrer" always;
add_header X-Content-Type-Options "nosniff" always;
add_header Cache-Control "no-store" always;
access_log off;
location ~ ^/(player|reading)\.(html|js)$ {
    limit_except GET { deny all; }
    types { text/html html; application/javascript js; }
    try_files $uri =404;
}
location / { return 404; }
